# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://courseflow:courseflow@localhost:5432/courseflow   # used by sqlx-cli and the query!() macros
COURSEFLOW_DATABASE_URL=postgres://courseflow:courseflow@localhost:5432/courseflow
COURSEFLOW_REDIS_URL=redis://localhost:6379/0
COURSEFLOW_HTTP_ADDR=127.0.0.1:8080
COURSEFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8080
COURSEFLOW_JWT_SECRET=dev-only-secret-change-me-please-32b
COURSEFLOW_BILLING_BASE_URL=http://127.0.0.1:8090
COURSEFLOW_BILLING_API_KEY=dev-api-key
COURSEFLOW_BILLING_WEBHOOK_SECRET=dev-webhook-secret
COURSEFLOW_ENV=local
COURSEFLOW_LOG_FORMAT=pretty
RUST_LOG=info,courseflow=debug,sqlx=warn

# Optional: OTLP/HTTP collector for traces (binary built with --features otel)
# COURSEFLOW_OTLP_ENDPOINT=http://localhost:4318
