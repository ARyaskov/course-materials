{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tessera chart values",
  "type": "object",
  "required": ["image", "ports", "api", "worker", "config", "service", "ingress", "secrets"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "publicHost": { "type": "string" },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },

    "image": {
      "type": "object",
      "required": ["repository"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },

    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },

    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "admin": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },

    "securityContext": { "type": "object" },
    "defaults": { "$ref": "#/$defs/workloadCommon" },
    "api": { "$ref": "#/$defs/workload" },
    "worker": { "$ref": "#/$defs/workload" },

    "config": {
      "type": "object",
      "properties": {
        "env": { "type": "string", "enum": ["dev", "staging", "prod", "preview"] },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "redisAddr": { "type": "string", "minLength": 1 },
        "redisDB": { "type": "integer", "minimum": 0, "maximum": 15 },
        "databaseMaxConn": { "type": "integer", "minimum": 1, "maximum": 200 },
        "holdTTL": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "shutdownDelay": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "shutdownGrace": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "extra": { "type": "object" },
        "rateLimits": { "type": "string" }
      }
    },

    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "exposeMetrics": { "type": "boolean" },
        "loadBalancerIP": { "type": "string" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "extraPorts": { "type": "array" }
      }
    },

    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },

    "extraIngresses": { "type": "array" },

    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" },
        "databaseDSN": { "type": "string" },
        "redisPassword": { "type": "string" },
        "ticketSignKey": { "type": "string" }
      }
    },

    "tests": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "scenario": { "type": "boolean" }
      }
    },

    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "preflight": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 30 },
        "resources": { "type": "object" }
      }
    },

    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },

    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },

    "metrics": {
      "type": "object",
      "properties": {
        "separateService": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
          }
        }
      }
    }
  },

  "$defs": {
    "workloadCommon": {
      "type": "object",
      "properties": {
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": ["object", "null"] },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "strategy": { "type": "object" },
        "resources": { "type": "object" },
        "probes": { "type": "object" },
        "metrics": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": ["object", "null"] },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
