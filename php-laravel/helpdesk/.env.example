APP_NAME=HelpDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=dev
APP_LOCALE=ru
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=secret
DB_SSLMODE=prefer

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_QUEUE=default

CACHE_STORE=redis
CACHE_PREFIX=helpdesk_cache
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@helpdesk.local
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hd_
CORS_ORIGINS=http://localhost:5173

FILESYSTEM_DISK=private
HELPDESK_DISK=private
HELPDESK_ATTACHMENT_MB=16
HELPDESK_OPEN_LIMIT=20
HELPDESK_SLA_HOURS=24
HELPDESK_ESCALATE_HOURS=48
HELPDESK_CHANNEL=mail

DIRECTORY_URL=https://directory.local/api/v1
DIRECTORY_KEY=
DIRECTORY_TIMEOUT=3
DIRECTORY_CACHE_TTL=600

CRM_URL=
CRM_KEY=
CRM_TOKEN=
CRM_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
