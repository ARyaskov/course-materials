# Образец переменных окружения. Настоящий .env в репозиторий не попадает:
# он перечислен в .gitignore и в .dockerignore.
#
# Переменные без значения по умолчанию обязательны — приложение падает
# при старте, а не работает на подставленном молчанием умолчании.

# --- обязательные ------------------------------------------------------------

# Ключ подписи токенов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEPOT_SECRET_KEY=

# Строка подключения к PostgreSQL
DEPOT_DATABASE_URL=postgresql+psycopg://depot:depot@localhost:5432/depot

# Строка подключения к Redis
DEPOT_REDIS_URL=redis://localhost:6379/0

# --- окружение ---------------------------------------------------------------

# development | testing | production
DEPOT_ENV=development

# plain для чтения глазами, json для сборщика журналов
DEPOT_LOG_FORMAT=plain
DEPOT_LOG_LEVEL=INFO

# --- ротация ключа подписи ---------------------------------------------------

# Прошлый ключ остаётся принимаемым на время жизни выданных токенов
DEPOT_SECRET_KEY_PREVIOUS=
DEPOT_TOKEN_KEY_ID=v1
DEPOT_TOKEN_KEY_ID_PREVIOUS=v0

# --- внешние зависимости -----------------------------------------------------

# redis | memory
DEPOT_QUEUE=redis
DEPOT_CACHE=redis

# local | s3 | memory
DEPOT_STORAGE=local
DEPOT_STORAGE_PATH=./var/uploads

# log | smtp | memory
DEPOT_NOTIFICATIONS=log

# fake | http
DEPOT_PAYMENT=fake
DEPOT_PAYMENT_URL=https://payments.example.com
DEPOT_PAYMENT_KEY=

# --- документация ------------------------------------------------------------

# В рабочем контуре описание API обычно закрыто: это карта поверхности
DEPOT_DOCS_ENABLED=true

# --- сервер приложений -------------------------------------------------------

DEPOT_BIND=0.0.0.0:8000
DEPOT_WORKERS=
DEPOT_THREADS=4
DEPOT_FORWARDED_ALLOW_IPS=127.0.0.1
