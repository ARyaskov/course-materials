<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule conversionWord="coloredLevel"
                  class="play.api.libs.logback.ColoredLevel"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- requestId кладёт в MDC filters.RequestIdFilter -->
      <pattern>%date{ISO8601} %coloredLevel [%X{requestId}] %logger{36} - %message%n%xException</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/beacon.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/beacon-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>14</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%date{ISO8601} %level [%X{requestId}] %logger - %message%n%xException</pattern>
    </encoder>
  </appender>

  <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>2048</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="FILE"/>
  </appender>

  <logger name="beacon" level="DEBUG"/>
  <logger name="play" level="INFO"/>
  <logger name="org.apache.pekko" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="INFO"/>
  <logger name="play.api.db.evolutions" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="ASYNC"/>
  </root>
</configuration>
