{
    "name": "helpdesk/api",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-openssl": "*",

        "yiisoft/config": "^1.6",
        "yiisoft/di": "^1.3",
        "yiisoft/injector": "^1.2",
        "yiisoft/yii-runner-http": "^2.0",
        "yiisoft/yii-runner-console": "^2.0",
        "yiisoft/router": "^3.0",
        "yiisoft/router-fastroute": "^3.0",
        "yiisoft/middleware-dispatcher": "^5.0",
        "yiisoft/yii-middleware": "^1.0",
        "yiisoft/data-response": "^2.0",
        "yiisoft/error-handler": "^4.0",
        "yiisoft/validator": "^2.0",
        "yiisoft/hydrator": "^1.0",
        "yiisoft/db": "^1.2",
        "yiisoft/db-pgsql": "^1.2",
        "yiisoft/db-migration": "^1.0",
        "yiisoft/cache": "^3.0",
        "yiisoft/cache-redis": "^3.0",
        "yiisoft/queue": "^3.0",
        "yiisoft/queue-db": "^1.0",
        "yiisoft/log": "^2.1",
        "yiisoft/log-target-file": "^3.0",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/aliases": "^3.0",
        "yiisoft/http": "^1.2",
        "yiisoft/request-provider": "^1.0",
        "yiisoft/rbac": "^2.0",
        "yiisoft/rbac-db": "^1.0",
        "httpsoft/http-message": "^1.1",
        "httpsoft/http-server-request": "^1.0",
        "psr/http-client": "^1.0",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "vimeo/psalm": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/config": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": ["common/params.php", "?params-local.php"],
            "di": ["common/di/*.php"],
            "di-web": ["$di", "web/di/*.php"],
            "di-console": ["$di", "console/di/*.php"],
            "events": ["common/events.php"],
            "events-web": ["$events", "web/events.php"],
            "events-console": ["$events", "console/events.php"],
            "bootstrap-web": ["common/bootstrap.php", "web/bootstrap.php"],
            "bootstrap-console": ["common/bootstrap.php"],
            "routes": ["web/routes.php"]
        },
        "config-plugin-environments": {
            "dev": { "params": ["dev/params.php"], "di": ["dev/di/*.php"] },
            "test": { "params": ["test/params.php"], "di": ["test/di/*.php"] },
            "prod": { "params": ["prod/params.php"], "di": ["prod/di/*.php"] }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "psalm": "psalm --no-cache",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@test:unit", "@psalm", "@cs"]
    }
}
