# Environment for automated tests. Kept separate from .env so a test run can
# never touch the development database.
NODE_ENV=test
PORT=3001
LOG_LEVEL=error
DATABASE_URL=postgresql://courseflow:courseflow@127.0.0.1:5432/courseflow_test?schema=public
REDIS_URL=redis://127.0.0.1:6379/1
JWT_SECRET=test_secret_change_me_min_32_chars_long_001
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173
