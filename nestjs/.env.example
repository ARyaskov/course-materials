# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (matches docker-compose.yml) ---
# Use 127.0.0.1 (not "localhost") on Windows: localhost can resolve to IPv6 ::1
# while Docker publishes the port on IPv4, causing Prisma P1001 errors.
DATABASE_URL=postgresql://courseflow:courseflow@127.0.0.1:5432/courseflow?schema=public

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Security ---
# Comma-separated browser origins allowed to call the API. Never "*" in production.
CORS_ORIGINS=http://localhost:5173
# Login brute-force budget: attempts per IP per minute / per email per hour.
LOGIN_RATE_LIMIT_PER_IP=5
LOGIN_RATE_LIMIT_PER_EMAIL=10

# --- Auth / JWT ---
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=dev_secret_change_me_min_32_chars_long_0001
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
