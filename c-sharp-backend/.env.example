# Скопируйте в .env и при необходимости поменяйте значения. Файл .env в git не попадает.

# Обязательно для профиля api (docker compose --profile api up): минимум 32 символа
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Порты на хосте (меняйте, если заняты другими проектами)
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
API_PORT=8080

# Учётные данные инфраструктуры (должны совпадать с ConnectionStrings в appsettings.Development.json)
POSTGRES_USER=courseflow
POSTGRES_PASSWORD=courseflow
POSTGRES_DB=courseflow
RABBITMQ_USER=courseflow
RABBITMQ_PASSWORD=courseflow
