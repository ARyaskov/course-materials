<Project Sdk="Microsoft.NET.Sdk">

  <!-- Обязательная строка: без Aspire.AppHost.Sdk проект не соберётся.
       Именно этот SDK генерирует класс Projects.*, через который
       AppHost ссылается на проекты решения (Глава 21.3). -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>courseflow-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ссылки на проекты, которые запускаем -->
    <ProjectReference Include="..\CourseFlow.Api\CourseFlow.Api.csproj">
      <IsAspireProjectResource>true</IsAspireProjectResource>
    </ProjectReference>
  </ItemGroup>

</Project>
