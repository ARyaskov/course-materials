{
  "name": "shipyard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Панель релизов и деплоев — сквозной проект курса «TypeScript 7 для JavaScript-разработчика»",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "shipyard": "./src/cli/main.ts"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#lib/*": "./src/lib/*",
    "#api/*": "./src/api/*",
    "#services/*": "./src/services/*",
    "#sdk/*": "./src/sdk/*",
    "#reports/*": "./src/reports/*",
    "#config/*": "./src/config/*",
    "#fixtures/*": "./src/fixtures/*",
    "#server/*": "./src/server/*",
    "#ui/*": "./src/ui/*",
    "#cli/*": "./src/cli/*",
    "#vendor/*": "./src/vendor/*"
  },
  "scripts": {
    "shipyard": "node src/cli/main.ts",
    "dev": "node --watch src/cli/main.ts status",
    "serve": "node src/cli/main.ts serve",
    "dev:ui": "esbuild src/ui/main.ts --bundle --outfile=public/board.js --format=esm --sourcemap --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src tests --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "test:coverage": "node --test --experimental-test-coverage tests/",
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:ui": "esbuild src/ui/main.ts --bundle --outfile=public/board.js --format=esm --minify --sourcemap",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
