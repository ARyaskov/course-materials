# Источник данных: fixtures — встроенный набор, http — внешний API
SHIPYARD_SOURCE=fixtures

# Базовый URL внешнего API (используется при SHIPYARD_SOURCE=http)
SHIPYARD_API_URL=http://127.0.0.1:8080/api

# Таймаут одного запроса и число повторов для сетевых ошибок
SHIPYARD_TIMEOUT_MS=5000
SHIPYARD_RETRIES=2

# Время жизни кеша ответов, мс
SHIPYARD_CACHE_TTL_MS=30000

# Уровень логирования: debug | info | warn | error
SHIPYARD_LOG_LEVEL=info

# Порт HTTP-сервера команды serve
PORT=8080
