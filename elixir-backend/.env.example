# Скопируйте в .env и заполните. Файл .env не коммитится.
# В разработке достаточно значений по умолчанию из config/dev.exs.

# База данных
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=klaxon_dev

# Прод-конфигурация (config/runtime.exs)
DATABASE_URL=ecto://postgres:postgres@db/klaxon_dev
SECRET_KEY_BASE=сгенерируйте_через_mix_phx.gen.secret
WEBHOOK_SIGNING_KEY=сгенерируйте_случайные_32_байта
PHX_HOST=localhost
PORT=4000
PHX_SERVER=true

# Пулы и лимиты
POOL_SIZE=10
OBAN_NOTIFICATIONS=20
OBAN_WEBHOOKS=10
RATE_LIMIT=600
RATE_LIMIT_WINDOW_MS=60000
DEDUP_WINDOW_MS=300000
HTTP_TIMEOUT_MS=5000

# Кластеризация (пусто — одиночный узел)
DNS_CLUSTER_QUERY=
