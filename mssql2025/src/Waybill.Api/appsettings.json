{
  "Waybill": {
    "ConnectionString": "Server=localhost;Database=Waybill;Integrated Security=true;Encrypt=Mandatory;TrustServerCertificate=true",
    "ApplicationName": "Waybill.Api",
    "CommandTimeoutSeconds": 30,
    "TransientRetryCount": 3
  },
  "Outbox": { "Enabled": true, "Workers": 2, "BatchSize": 50, "LeaseSeconds": 60, "IdleDelayMs": 1000, "MaxIdleDelayMs": 5000, "Webhooks": {} },
  "Ai": { "Enabled": false, "EmbeddingsUrl": "http://localhost:11434/api/embed", "Model": "nomic-embed-text", "Dimensions": 768, "TimeoutSeconds": 15 },
  "Telemetry": { "Console": false },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080"
}
