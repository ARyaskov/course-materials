# Скопировать в .env.local (для запуска из IDE) — оба файла в .gitignore
ATRIUM_ENV=dev
ATRIUM_DATABASE_URL=jdbc:postgresql://localhost:5432/atrium
ATRIUM_DATABASE_USER=atrium
ATRIUM_DATABASE_PASSWORD=atrium
ATRIUM_KAFKA_BOOTSTRAP=localhost:29092
ATRIUM_REDIS_URL=redis://localhost:6379
ATRIUM_PAYGATE_BASE_URL=http://localhost:8090
ATRIUM_PAYGATE_API_KEY=dev-key
ATRIUM_NOTIFY_BASE_URL=http://localhost:8091
ATRIUM_NOTIFY_API_KEY=dev-key
ATRIUM_OTLP_ENDPOINT=http://localhost:4318
ATRIUM_TRACE_SAMPLING=1.0
# порт PostgreSQL на хосте (в .env, читается compose.yml)
# ATRIUM_PG_PORT=15432
