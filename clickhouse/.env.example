# Pulse: имена переменных окружения для секретов (глава 17). Скопировать в .env и заполнить; .env не коммитится.
# Docker Compose подставляет их в контейнер; конфигурация читает через атрибут from_env.

# Учётная запись стенда (создаётся образом при первом запуске)
CLICKHOUSE_USER=analyst
CLICKHOUSE_PASSWORD=analyst

# Пароли ролей из ddl/access.sql (на реальной установке подставляются при применении файла)
PULSE_INGEST_PASSWORD=ingest-stand-only
PULSE_DASHBOARD_PASSWORD=dashboard-stand-only

# Объектное хранилище (config/config.d/storage.xml может читать их через from_env вместо значений в файле)
S3_ACCESS_KEY=pulse
S3_SECRET_KEY=pulse-secret

# Ключ шифрования диска (hex, 32 байта для AES-256), если включён диск типа encrypted
DISK_ENCRYPTION_KEY_HEX=
