<!-- Pulse: экспорт метрик сервера для сборщиков (глава 15). Проверка: curl http://localhost:9363/metrics
     Порт 9363 нужно пробросить в docker-compose.yml, если сборщик работает вне сети Compose. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <errors>true</errors>
    </prometheus>
</clickhouse>
